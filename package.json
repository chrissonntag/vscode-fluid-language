{
  "name": "vscode-fluid-language",
  "displayName": "Fluid Template Language",
  "description": "VScode extension for Fluid Template Language",
  "license": "MIT",
  "version": "0.0.1",
  "publisher": "praetorius",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fluid",
        "aliases": [
          "Fluid",
          "fluid"
        ],
        "filenamePatterns": [
          "*.fluid.*",
          "**/Resources/Private/**/{Templates,Layouts,Partials,Components}/**/*.txt",
          "**/ContentBlocks/**/templates/**/*.txt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icon.svg",
          "light": "./icon.svg"
        }
      },
      {
        "id": "html-fluid",
        "aliases": [
          "HTML (Fluid)",
          "html-fluid"
        ],
        "filenamePatterns": [
          "*.fluid.html",
          "**/Resources/Private/**/{Templates,Layouts,Partials,Components}/**/*.html",
          "**/ContentBlocks/**/templates/**/*.html"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icon.svg",
          "light": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "fluid",
        "scopeName": "text.fluid",
        "path": "./syntaxes/fluid.tmLanguage.json"
      },
      {
        "language": "html-fluid",
        "scopeName": "text.html.fluid",
        "path": "./syntaxes/html-fluid.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint",
    "postinstall": "cd client && npm install && cd ..",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
