{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Fluid",
	"scopeName": "text.fluid",
	"patterns": [
		{
			"include": "#namespace-inline"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#cdata"
		},
		{
			"include": "#namespace-xmlns"
		},
		{
			"include": "#viewhelper-tag"
		},
		{
			"include": "#expression"
		}
	],
	"repository": {
		"cdata": {
			"begin": "<!\\[CDATA\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.tag.begin.fluid"
				}
			},
			"contentName": "string.other.inline-data.fluid",
			"end": "]]>",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.fluid"
				}
			},
			"patterns": [
				{
					"match": "\\{\\{\\{((true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+))\\}\\}\\}",
					"captures": {
						"2": {
							"name": "variable.language.fluid"
						},
						"3": {
							"name": "variable.other.fluid"
						}
					}
				}
			],
			"name": "meta.tag.metadata.cdata.fluid"
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.block.fluid",
					"begin": "<f:comment>",
					"end": "</f:comment>"
				}
			]
		},
		"namespace-inline": {
			"patterns": [
				{
					"match": "(\\{)(namespace\\s+[a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*)\\s*((=)\\s*(([A-Za-z0-9\\.]+|Tx)(\\\\\\w+)+)\\s*)?(})",
					"captures": {
						"1": {
							"name": "punctuation.definition.expression.begin.fluid"
						},
						"2": {
							"name": "support.type.fluid"
						},
						"4": {
							"name": "punctuation.separator.key-value.fluid"
						},
						"5": {
							"name": "string.quoted.double.fluid"
						},
						"6": {
							"name": "punctuation.definition.expression.end.fluid"
						}
					}
				}
			]
		},
		"viewhelper-tag": {
			"patterns": [
				{
					"begin": "(?i)(<)([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9\\.]+)(?=\\s|/?>)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.tag.begin.fluid"
						},
						"2": {
							"name": "entity.name.function.fluid"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.tag.end.fluid"
						}
					},
					"name": "meta.viewhelper.structure.$2.start.fluid",
					"patterns": [
						{
							"include": "#viewhelper-tag-attribute"
						},
						{
							"begin": "\\{",
							"end": "\\}",
							"name": "invalid.illegal.viewhelper-expression-in-viewhelper-tag.fluid"
						}
					]
				},
				{
					"begin": "(?i)(</)([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9\\.]+)(?=\\s|/?>)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.tag.begin.fluid"
						},
						"2": {
							"name": "entity.name.function.fluid"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.tag.end.fluid"
						}
					},
					"name": "meta.viewhelper.structure.$2.end.fluid",
					"patterns": [
						{
							"include": "#viewhelper-tag-attribute"
						}
					]
				}
			]
		},
		"viewhelper-tag-attribute": {
			"begin": "([a-zA-Z\\-]+)(?![\\w:-])",
			"beginCaptures": {
				"0": {
					"name": "entity.other.attribute-name.fluid"
				}
			},
			"end": "(?=\\s*+[^=\\s])",
			"name": "meta.attribute.fluid",
			"patterns": [
				{
					"include": "#viewhelper-tag-attribute-interior"
				}
			]
		},
		"viewhelper-tag-attribute-interior": {
			"patterns": [
				{
					"begin": "=",
					"beginCaptures": {
						"0": {
							"name": "punctuation.separator.key-value.fluid"
						}
					},
					"end": "(?<=[^\\s=])(?!\\s*=)|(?=/?>)",
					"patterns": [
						{
							"begin": "\"",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.fluid"
								}
							},
							"end": "\"",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.fluid"
								}
							},
							"name": "string.quoted.double.fluid",
							"patterns": [
								{
									"include": "#expression"
								},
								{
									"include": "text.html.basic#entities"
								}
							]
						},
						{
							"begin": "'",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.fluid"
								}
							},
							"end": "'",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.fluid"
								}
							},
							"name": "string.quoted.single.fluid",
							"patterns": [
								{
									"include": "#expression"
								},
								{
									"include": "text.html.basic#entities"
								}
							]
						},
						{
							"match": "=",
							"name": "invalid.illegal.unexpected-equals-sign.fluid"
						}
					]
				}
			]
		},
		"expression": {
			"name": "entity.expression.fluid",
			"begin": "\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.tag.begin.fluid"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.fluid"
				}
			},
			"patterns": [			
				{
					"match": "(?<=\\{)((true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+))(?=\\s+as|\\s*[-\\^+%/*?]|\\})",
					"captures": {
						"2": {
							"name": "variable.language.fluid"
						},
						"3": {
							"name": "variable.other.fluid"
						}
					}
				},
				{
					"match": "(?<=\\s+)as\\s+(integer|boolean|string|float|array|DateTime)(?=\\})",
					"captures": {
						"1": {
							"name": "support.type.fluid"
						}
					}
				},
				{
					"match": "\\?\\s*((true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+))\\s*:\\s*((true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+))(?=\\})",
					"captures": {
						"2": {
							"name": "variable.language.fluid"
						},
						"3": {
							"name": "variable.other.fluid"
						},
						"5": {
							"name": "variable.language.fluid"
						},
						"6": {
							"name": "variable.other.fluid"
						}
					}
				},
				{
					"match": "\\?:\\s*((true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+))(?=\\})",
					"captures": {
						"2": {
							"name": "variable.language.fluid"
						},
						"3": {
							"name": "variable.other.fluid"
						}
					}
				},
				{
					"begin": "(\\->)?\\s*([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9_\\-\\.]+)\\s*(\\()",
					"end": "\\)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.function.arrow.fluid"
						},
						"2": {
							"name": "entity.name.function.fluid"
						},
						"3": {
							"name": "punctuation.definition.function.begin.fluid"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.function.end.fluid"
						}
					},
					"patterns": [
						{
							"match": "(?<=(^|[\\(,])\\s*)([a-zA-Z0-9_\\-]+)(?=\\s*:)",
							"captures": {
								"2": {
									"name": "entity.other.attribute-name.fluid"
								}
							}
						},
						{
							"begin": ":",
							"end": "(?=[,\\)\\n])",
							"patterns": [
								{
									"match": "(?<=:\\s*)(true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+)(?=\\s*[,\\)\\n])",
									"captures": {
										"1": {
											"name": "variable.language.fluid"
										},
										"2": {
											"name": "variable.other.fluid"
										}
									}
								},
								{
									"begin": "(?<=:\\s*)\\\"",
									"end": "\\\"(?=\\s*[,\\)\\n])",
									"name": "string.quoted.double.fluid",
									"patterns": [
										{
											"include": "#expression"
										}
									]
								},
								{
									"begin": "(?<=:\\s*)'",
									"end": "'(?=\\s*[,\\)\\n])",
									"name": "string.quoted.single.fluid",
									"patterns": [
										{
											"include": "#expression"
										}
									]
								},
								{
									"begin": "(?<=:\\s*)\\{",
									"end": "\\}(?=\\s*[,\\)\\n])",
									"patterns": [
										{
											"include": "#array"
										}
									]
								}
							]
						}
					]
				},
				{
					"include": "#array"
				}
			]
		},
		"array": {
			"name": "entity.expression.array.fluid",
			"patterns": [
				{
					"match": "(?<=(^|[\\{,])\\s*)((['\"]?)[a-zA-Z0-9_\\-]+\\3)(?=\\s*:)",
					"captures": {
						"2": {
							"name": "entity.other.attribute-name.fluid"
						}
					}
				},
				{
					"begin": ":",
					"end": "(?=[,\\}\\n])",
					"patterns": [
						{
							"match": "(?<=:\\s*)(true|false|null|_all)|([a-zA-Z0-9_\\-\\.]+)(?=\\s*[,\\}\\n])",
							"captures": {
								"1": {
									"name": "variable.language.fluid"
								},
								"2": {
									"name": "variable.other.fluid"
								}
							}
						},
						{
							"begin": "(?<=:\\s*)(?<!\\\\)\\\"",
							"end": "(?<!\\\\)\\\"(?=\\s*[,\\}\\n])",
							"name": "string.quoted.double.fluid"
						},
						{
							"begin": "(?<=:\\s*)(?<!\\\\)'",
							"end": "(?<!\\\\)'(?=\\s*[,\\}\\n])",
							"name": "string.quoted.single.fluid"
						},
						{
							"begin": "(?<=:\\s*)\\{",
							"end": "\\}(?=\\s*[,\\)\\}\\n])",
							"patterns": [
								{
									"include": "#array"
								}
							]
						}
					]
				}
			]
		}
	}
}