{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Fluid",
	"scopeName": "text.fluid",
	"injections": {
		"R:text.fluid - (comment.block, text.html meta.embedded, meta.tag.*.*.html, meta.tag.*.*.*.html, meta.tag.*.*.*.*.html)": {
			"comment": "Uses R: to ensure this matches after any other injections.",
			"patterns": [
				{
					"match": "<",
					"name": "invalid.illegal.bad-angle-bracket.html"
				}
			]
		},
		"L:meta.tag - (meta.tag.metadata.cdata)": {
			"comment": "Allow inline expressions within regular HTML tags",
			"patterns": [
				{
					"include": "#viewhelper-expression"
				}
			]
		},
		"L:comment.block.html": {
			"comment": "Allow inline expressions within regular HTML comments",
			"patterns": [
				{
					"include": "#viewhelper-expression"
				}
			]
		}
	},
	"patterns": [
		{
			"include": "#namespace-inline"
		},
		{
			"include": "text.html.basic#xml-processing"
		},
		{
			"include": "text.html.basic#comment"
		},
		{
			"include": "#comment"
		},
		{
			"include": "text.html.basic#doctype"
		},
		{
			"include": "#cdata"
		},
		{
			"include": "#namespace-xmlns"
		},
		{
			"include": "#viewhelper-tag"
		},
		{
			"include": "text.html.basic#tags-valid"
		},
		{
			"include": "#viewhelper-expression"
		},
		{
			"include": "text.html.basic#entities"
		}
	],
	"repository": {
		"attribute": {
			"begin": "([a-zA-Z\\-]+)(?![\\w:-])",
			"beginCaptures": {
				"0": {
					"name": "entity.other.attribute-name.fluid"
				}
			},
			"end": "(?=\\s*+[^=\\s])",
			"name": "meta.attribute",
			"patterns": [
				{
					"include": "#attribute-interior"
				}
			]
		},
		"attribute-interior": {
			"patterns": [
				{
					"begin": "=",
					"beginCaptures": {
						"0": {
							"name": "punctuation.separator.key-value.fluid"
						}
					},
					"end": "(?<=[^\\s=])(?!\\s*=)|(?=/?>)",
					"patterns": [
						{
							"begin": "\"",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.fluid"
								}
							},
							"end": "\"",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.fluid"
								}
							},
							"name": "string.quoted.double.fluid",
							"patterns": [
								{
									"include": "#viewhelper-expression"
								},
								{
									"include": "text.html.basic#entities"
								}
							]
						},
						{
							"begin": "'",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.fluid"
								}
							},
							"end": "'",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.fluid"
								}
							},
							"name": "string.quoted.single.fluid",
							"patterns": [
								{
									"include": "#viewhelper-expression"
								},
								{
									"include": "text.html.basic#entities"
								}
							]
						},
						{
							"match": "=",
							"name": "invalid.illegal.unexpected-equals-sign.fluid"
						}
					]
				}
			]
		},
		"cdata": {
			"begin": "<!\\[CDATA\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.tag.begin"
				}
			},
			"contentName": "string.other.inline-data.fluid",
			"end": "]]>",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.fluid"
				}
			},
			"patterns": [
				{
					"name": "variable.language.fluid",
					"match": "\\{\\{\\{(true|false|null|_all)\\}\\}\\}"
				},
				{
					"name": "variable.other.fluid",
					"match": "\\{\\{\\{[a-zA-Z0-9_\\-\\.]+\\}\\}\\}"
				}
			],
			"name": "meta.tag.metadata.cdata.fluid"
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.block.fluid",
					"begin": "<f:comment>",
					"end": "</f:comment>"
				}
			]
		},
		"namespace-inline": {
			"patterns": [
				{
					"match": "(\\{)(namespace\\s+[a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*)\\s*((=)\\s*(([A-Za-z0-9\\.]+|Tx)(\\\\\\w+)+)\\s*)?(})",
					"captures": {
						"1": {
							"name": "punctuation.definition.expression.begin.fluid"
						},
						"2": {
							"name": "support.type.fluid"
						},
						"4": {
							"name": "punctuation.separator.key-value.fluid"
						},
						"5": {
							"name": "string.quoted.double.fluid"
						},
						"6": {
							"name": "punctuation.definition.expression.end.fluid"
						}
					}
				}
			]
		},
		"namespace-xmlns": {
			"begin": "(?i)(<)(html)(?=\\s|/?>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.html"
				},
				"2": {
					"name": "entity.name.tag.html"
				}
			},
			"end": ">",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.html"
				}
			},
			"name": "meta.tag.structure.$2.start.html",
			"patterns": [
				{
					"begin": "xmlns:[a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*",
					"beginCaptures": {
						"0": {
							"name": "support.type.fluid"
						}
					},
					"end": "(?=\\s*+[^=\\s])",
					"patterns": [
						{
							"include": "text.html.basic#attribute-interior"
						}
					]
				},
				{
					"match": "(data-namespace-typo3-fluid)(=)(\\\"true\\\")",
					"captures": {
						"1": {
							"name": "support.type"
						},
						"2": {
							"name": "punctuation.separator.key-value.html"
						},
						"3": {
							"name": "string.quoted.double.html"
						}
					}
				},
				{
					"include": "text.html.basic#attribute"
				}
			]
		},
		"viewhelper-tag": {
			"patterns": [
				{
					"begin": "(?i)(<)([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9\\.]+)(?=\\s|/?>)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.tag.begin.fluid"
						},
						"2": {
							"name": "entity.name.function.fluid"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.tag.end.fluid"
						}
					},
					"name": "meta.tag.structure.$2.start.fluid",
					"patterns": [
						{
							"include": "#attribute"
						},
						{
							"begin": "\\{",
							"end": "\\}",
							"name": "invalid.illegal.viewhelper-expression-in-viewhelper-tag"
						}
					]
				},
				{
					"begin": "(?i)(</)([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9\\.]+)(?=\\s|/?>)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.tag.begin.fluid"
						},
						"2": {
							"name": "entity.name.function.fluid"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.tag.end.fluid"
						}
					},
					"name": "meta.tag.structure.$2.end.fluid",
					"patterns": [
						{
							"include": "#attribute"
						}
					]
				}
			]
		},
		"viewhelper-expression": {
			"name": "entity.expression.fluid",
			"begin": "\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.tag.begin.fluid"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.fluid"
				}
			},
			"patterns": [
				{
					"name": "variable.language.fluid",
					"match": "(?<=\\{)(true|false|null|_all)(?=\\s*\\->|\\})"
				},
				{
					"name": "variable.other.fluid",
					"match": "(?<=\\{)[a-zA-Z0-9_\\-\\.]+(?=\\s*\\->|\\})"
				},
				{
					"begin": "(\\->)?\\s*([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9_\\-\\.]+)\\s*(\\()",
					"end": "\\)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.function.arrow.fluid"
						},
						"2": {
							"name": "entity.name.function.fluid"
						},
						"3": {
							"name": "punctuation.definition.function.begin.fluid"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.function.end.fluid"
						}
					},
					"patterns": [
						{
							"match": "(?<=(^|[\\(,])\\s*)([a-zA-Z0-9_\\-]+)(?=\\s*:)",
							"captures": {
								"2": {
									"name": "entity.other.attribute-name.fluid"
								}
							}
						},
						{
							"begin": ":",
							"end": "(?=[,\\)\\n])",
							"patterns": [
								{
									"match": "(?<=:\\s*)(true|false|null|_all)(?=\\s*[,\\)\\n])",
									"name": "variable.language.fluid"
								},
								{
									"match": "(?<=:\\s*)[a-zA-Z0-9_\\-\\.]+(?=\\s*[,\\)\\n])",
									"name": "variable.other.fluid"
								},
								{
									"begin": "(?<=:\\s*)\\\"",
									"end": "\\\"(?=\\s*[,\\)\\n])",
									"name": "string.quoted.double.fluid",
									"patterns": [
										{
											"include": "#viewhelper-expression"
										}
									]
								},
								{
									"begin": "(?<=:\\s*)'",
									"end": "'(?=\\s*[,\\)\\n])",
									"name": "string.quoted.single.fluid",
									"patterns": [
										{
											"include": "#viewhelper-expression"
										}
									]
								},
								{
									"begin": "(?<=:\\s*)\\{",
									"end": "\\}(?=\\s*[,\\)\\n])",
									"patterns": [
										{
											"include": "#array"
										}
									]
								}
							]
						}
					]
				}
			]
		},
		"array": {
			"patterns": [
				{
					"match": "(?<=(^|[\\{,])\\s*)([a-zA-Z0-9_\\-]+)(?=\\s*:)",
					"captures": {
						"2": {
							"name": "entity.other.attribute-name.fluid"
						}
					}
				},
				{
					"begin": ":",
					"end": "(?=[,\\}\\n])",
					"patterns": [
						{
							"match": "(?<=:\\s*)(true|false|null|_all)(?=\\s*[,\\}\\n])",
							"name": "variable.language.fluid"
						},
						{
							"match": "(?<=:\\s*)[a-zA-Z0-9_\\-\\.]+(?=\\s*[,\\}\\n])",
							"name": "variable.other.fluid"
						},
						{
							"begin": "(?<=:\\s*)\\\"",
							"end": "\\\"(?=\\s*[,\\}\\n])",
							"name": "string.quoted.double.fluid"
						},
						{
							"begin": "(?<=:\\s*)'",
							"end": "'(?=\\s*[,\\}\\n])",
							"name": "string.quoted.single.fluid"
						},
						{
							"begin": "(?<=:\\s*)\\{",
							"end": "\\}(?=\\s*[,\\)\\}\\n])",
							"patterns": [
								{
									"include": "#array"
								}
							]
						}
					]
				}
			]
		}
	}
}