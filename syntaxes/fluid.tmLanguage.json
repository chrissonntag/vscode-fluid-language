{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Fluid",
	"scopeName": "text.html.fluid",
	"injections": {
		"R:text.html - (comment.block, text.html meta.embedded, meta.tag.*.*.html, meta.tag.*.*.*.html, meta.tag.*.*.*.*.html)": {
			"comment": "Uses R: to ensure this matches after any other injections.",
			"patterns": [
				{
					"match": "<",
					"name": "invalid.illegal.bad-angle-bracket.html"
				}
			]
		}
	},
	"patterns": [
		{
			"include": "#namespace-inline"
		},
		{
			"include": "text.html.basic#xml-processing"
		},
		{
			"include": "text.html.basic#comment"
		},
		{
			"include": "#comment"
		},
		{
			"include": "text.html.basic#doctype"
		},
		{
			"include": "#cdata"
		},
		{
			"include": "#namespace-xmlns"
		},
		{
			"include": "#viewhelper-tag"
		},
		{
			"include": "text.html.basic#tags-valid"
		},
		{
			"include": "#viewhelper-expression"
		},
		{
			"include": "text.html.basic#entities"
		}
	],
	"repository": {
		"attribute": {
			"begin": "([a-z\\-]+)(?![\\w:-])",
			"beginCaptures": {
				"0": {
					"name": "entity.other.attribute-name"
				}
			},
			"end": "(?=\\s*+[^=\\s])",
			"name": "meta.attribute",
			"patterns": [
				{
					"include": "#attribute-interior"
				}
			]
		},
		"attribute-interior": {
			"patterns": [
				{
					"begin": "=",
					"beginCaptures": {
						"0": {
							"name": "punctuation.separator.key-value"
						}
					},
					"end": "(?<=[^\\s=])(?!\\s*=)|(?=/?>)",
					"patterns": [
						{
							"match": "([^\\s\"'=<>`/]|/(?!>))+",
							"name": "string.unquoted"
						},
						{
							"begin": "(\")\\{",
							"beginCaptures": {
								"1": {
									"name": "punctuation.definition.string.begin"
								}
							},
							"end": "\\}(\")",
							"endCaptures": {
								"1": {
									"name": "punctuation.definition.string.end"
								}
							},
							"name": "string.quoted.double",
							"patterns": [
								{
									"include": "#array"
								}
							]
						},
						{
							"begin": "\"",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin"
								}
							},
							"end": "\"",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end"
								}
							},
							"name": "string.quoted.double",
							"patterns": [
								{
									"include": "text.html.basic#entities"
								}
							]
						},
						{
							"begin": "(')\\{",
							"beginCaptures": {
								"1": {
									"name": "punctuation.definition.string.begin"
								}
							},
							"end": "\\}(')",
							"name": "string.quoted.single",
							"endCaptures": {
								"1": {
									"name": "punctuation.definition.string.end"
								}
							},
							"patterns": [
								{
									"include": "#array"
								}
							]
						},
						{
							"begin": "'",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin"
								}
							},
							"end": "'",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end"
								}
							},
							"name": "string.quoted.single",
							"patterns": [
								{
									"include": "text.html.basic#entities"
								}
							]
						},
						{
							"match": "=",
							"name": "invalid.illegal.unexpected-equals-sign"
						}
					]
				}
			]
		},
		"cdata": {
			"begin": "<!\\[CDATA\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.tag.begin"
				}
			},
			"contentName": "string.other.inline-data",
			"end": "]]>",
			"patterns": [
				{
					"name": "variable.language",
					"match": "\\{\\{\\{(true|false|null|_all)\\}\\}\\}"
				},
				{
					"name": "variable.other",
					"match": "\\{\\{\\{[a-zA-Z0-9_\\-\\.]+\\}\\}\\}"
				}
			],
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end"
				}
			},
			"name": "meta.tag.metadata.cdata.html"
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.block",
					"begin": "<f:comment>",
					"end": "</f:comment>"
				}
			]
		},
		"namespace-inline": {
			"patterns": [
				{
					"name": "support.type",
					"match": "\\{namespace\\s+[a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*\\s*(=\\s*(([A-Za-z0-9\\.]+|Tx)(\\\\\\w+)+)\\s*)?}"
				}
			]
		},
		"namespace-xmlns": {
			"begin": "(?i)(<)(html)(?=\\s|/?>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.html"
				},
				"2": {
					"name": "entity.name.tag.html"
				}
			},
			"end": ">",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.html"
				}
			},
			"name": "meta.tag.structure.$2.start.html",
			"patterns": [
				{
					"name": "support.type",
					"begin": "xmlns:[a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*",
					"end": "(?=\\s*+[^=\\s])",
					"patterns": [
						{
							"include": "text.html.basic#attribute-interior"
						}
					]
				},
				{
					"name": "support.type",
					"match": "data-namespace-typo3-fluid=\\\"true\\\""
				},
				{
					"include": "text.html.basic#attribute"
				}
			]
		},
		"viewhelper-tag": {
			"patterns": [
				{
					"begin": "(?i)(<)([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9\\.]+)(?=\\s|/?>)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.tag.begin.html"
						},
						"2": {
							"name": "entity.name.function"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.tag.end.html"
						}
					},
					"name": "meta.tag.structure.$2.start.html",
					"patterns": [
						{
							"include": "#attribute"
						}
					]
				},
				{
					"begin": "(?i)(</)([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9\\.]+)(?=\\s|/?>)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.tag.begin.html"
						},
						"2": {
							"name": "entity.name.function"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.tag.end.html"
						}
					},
					"name": "meta.tag.structure.$2.end.html",
					"patterns": [
						{
							"include": "#attribute"
						}
					]
				}
			]
		},
		"viewhelper-expression": {
			"patterns": [
				{
					"begin": "\\{",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.expression.begin"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.expression.end"
						}
					},
					"patterns": [
						{
							"name": "variable.language",
							"match": "(?<=\\{)(true|false|null|_all)(?=\\s*\\->|\\})"
						},
						{
							"name": "variable.other",
							"match": "(?<=\\{)[a-zA-Z0-9_\\-\\.]+(?=\\s*\\->|\\})"
						},
						{
							"begin": "(\\->)?\\s*([a-zA-Z\\*]+[a-zA-Z0-9\\.\\*]*:[a-zA-Z0-9_\\-\\.]+)\\s*(\\()",
							"end": "\\)",
							"beginCaptures": {
								"1": {
									"name": "punctuation.definition.function.arrow"
								},
								"2": {
									"name": "entity.name.function"
								},
								"3": {
									"name": "punctuation.definition.function.begin"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.function.end"
								}
							},
							"patterns": [
								{
									"match": "(?<=(^|[\\(,])\\s*)([a-zA-Z0-9_\\-]+)(?=\\s*:)",
									"captures": {
										"2": {
											"name": "entity.other.attribute-name"
										}
									}
								},
								{
									"begin": ":",
									"end": "(?=[,\\)\\n])",
									"patterns": [
										{
											"match": "(?<=:\\s*)(true|false|null|_all)(?=\\s*[,\\)\\n])",
											"name": "variable.language"
										},
										{
											"match": "(?<=:\\s*)[a-zA-Z0-9_\\-\\.]+(?=\\s*[,\\)\\n])",
											"name": "variable.other"
										},
										{
											"begin": "(?<=:\\s*)\\\"",
											"end": "\\\"(?=\\s*[,\\)\\n])",
											"name": "string.quoted.double"
										},
										{
											"begin": "(?<=:\\s*)'",
											"end": "'(?=\\s*[,\\)\\n])",
											"name": "string.quoted.single"
										},
										{
											"begin": "(?<=:\\s*)\\{",
											"end": "\\}(?=\\s*[,\\)\\n])",
											"patterns": [
												{
													"include": "#array"
												}
											]
										}
									]
								}
							]
						}
					]
				}
			]
		},
		"array": {
			"patterns": [
				{
					"match": "(?<=(^|[\\{,])\\s*)([a-zA-Z0-9_\\-]+)(?=\\s*:)",
					"captures": {
						"2": {
							"name": "entity.other.attribute-name"
						}
					}
				},
				{
					"begin": ":",
					"end": "(?=[,\\}\\n])",
					"patterns": [
						{
							"match": "(?<=:\\s*)(true|false|null|_all)(?=\\s*[,\\}\\n])",
							"name": "variable.language"
						},
						{
							"match": "(?<=:\\s*)[a-zA-Z0-9_\\-\\.]+(?=\\s*[,\\}\\n])",
							"name": "variable.other"
						},
						{
							"begin": "(?<=:\\s*)\\\"",
							"end": "\\\"(?=\\s*[,\\}\\n])",
							"name": "string.quoted.double"
						},
						{
							"begin": "(?<=:\\s*)'",
							"end": "'(?=\\s*[,\\}\\n])",
							"name": "string.quoted.single"
						},
						{
							"begin": "(?<=:\\s*)\\{",
							"end": "\\}(?=\\s*[,\\)\\}\\n])",
							"patterns": [
								{
									"include": "#array"
								}
							]
						}
					]
				}
			]
		}
	}
}